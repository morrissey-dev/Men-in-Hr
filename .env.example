# Men in HR Connect — server-side configuration (Netlify environment variables).
# NEVER commit a populated .env or place secrets in VITE_* variables.
# All gates MUST be enabled before real applications can be accepted.
APPLICATIONS_OPEN=false
PRIVACY_APPROVED=false
RETENTION_PROCESS_ACTIVE=false

# Use the exact public origin of the deployed site (no trailing slash).
SITE_ORIGIN=https://YOUR-SITE.netlify.app

# Server-side only. Use Supabase's new sb_secret_... API key.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=REPLACE_ME
APPLICATION_COHORT_SLUG=cohort-1

# Cloudflare Turnstile: both a public site key and a PRIVATE secret key.
TURNSTILE_SITE_KEY=REPLACE_ME
TURNSTILE_SECRET_KEY=REPLACE_ME

# The approved privacy data controller, contact and retention period.
PRIVACY_CONTROLLER_NAME=REPLACE_WITH_APPROVED_ORGANISATION
PRIVACY_CONTACT_EMAIL=privacy@example.org
APPLICATION_RETENTION_DAYS=180

# v0.3.0: Admin dashboard is deliberately OFF until approved and provisioned.
ADMIN_DASHBOARD_ENABLED=false
# Set to the same HTTPS origin/project as SITE_ORIGIN, SUPABASE_URL above.
# A PUBLISHABLE key is safe to expose, but it never grants access by itself.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
VITE_ADMIN_LOGIN_ENABLED=false
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# v0.5.0: personal facilitation desk. Server-side ONLY.
# Leave unset to hide the desk; after Supabase Auth setup, use the approved
# owner's UUID (not their email). This is NOT a public VITE_ variable.
# FACILITATOR_USER_ID=00000000-0000-0000-0000-000000000000

# v0.7.0: optional private manual cloud backup; OFF until Supabase setup is verified.
FACILITATION_CLOUD_SYNC_ENABLED=false
